# Servidor
PORT=3000

# Postgres (Neon en producción, embedded-postgres en local vía npm run dev:db)
DATABASE_URL=postgresql://user:password@localhost:5432/setter_ia

# Panel de administración (token compartido, tratar como contraseña)
ADMIN_BEARER_TOKEN=

# Clave para cifrar en reposo las credenciales que cada cliente carga desde la
# pestaña Conexiones (WhatsApp, Meta, Anthropic) — NO son las credenciales en
# sí, solo la llave con la que se cifran/descifran en base de datos.
# Generar una nueva por instancia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Modelo de Claude por defecto (el cliente puede sobreescribirlo en Conexiones)
CLAUDE_MODEL=claude-sonnet-5
